# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional Indian Payment Gateway Integration (Razorpay Test / Live Keys)
# Leave unset to run checkout in Test Mode placeholder state.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional SMTP Credentials for Automated Order Status Email Notifications
# Configure in Cloud Run / Server env and Firebase Functions Secrets
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="SIRIMAGGA Orders <orders@sirimagga.example>"

# Optional WhatsApp Business Phone Number (Country code + digits, e.g. 919000000000)
VITE_WHATSAPP_NUMBER="919000000000"

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Core helper primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'sanjugotur6@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity validators
    function isValidProduct(data) {
      return data.keys().hasAll([
        'title', 'slug', 'productCode', 'description', 'category', 'sareeType',
        'fabricInfo', 'sareeLength', 'careInstructions', 'sellingPrice',
        'colorOptions', 'images', 'availabilityStatus', 'isBestseller',
        'isNewArrival', 'popularityScore', 'isDemo', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title', 'slug', 'productCode', 'description', 'category', 'sareeType',
        'fabricInfo', 'sareeLength', 'blousePieceInfo', 'careInstructions',
        'sellingPrice', 'originalPrice', 'discountPercent', 'colorOptions',
        'images', 'availabilityStatus', 'estimatedDispatchDays', 'isBestseller',
        'isNewArrival', 'popularityScore', 'isDemo', 'createdAt', 'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
      data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 160 && data.slug.matches('^[a-z0-9-]+$') &&
      data.productCode is string && data.productCode.size() >= 2 && data.productCode.size() <= 40 && data.productCode.matches('^[A-Z0-9-]+$') &&
      data.description is string && data.description.size() >= 5 && data.description.size() <= 2500 &&
      data.category is string && data.category.size() >= 2 && data.category.size() <= 80 &&
      data.sareeType is string && data.sareeType.size() >= 2 && data.sareeType.size() <= 80 &&
      data.fabricInfo is string && data.fabricInfo.size() >= 2 && data.fabricInfo.size() <= 300 &&
      data.sareeLength is string && data.sareeLength.size() >= 2 && data.sareeLength.size() <= 120 &&
      (!('blousePieceInfo' in data) || (data.blousePieceInfo is string && data.blousePieceInfo.size() <= 200)) &&
      data.careInstructions is string && data.careInstructions.size() >= 2 && data.careInstructions.size() <= 400 &&
      data.sellingPrice is number && data.sellingPrice >= 1 && data.sellingPrice <= 1000000 &&
      (!('originalPrice' in data) || (data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice <= 1000000)) &&
      (!('discountPercent' in data) || (data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 95)) &&
      data.colorOptions is list && data.colorOptions.size() >= 1 && data.colorOptions.size() <= 12 && data.colorOptions[0] is string &&
      data.images is list && data.images.size() >= 1 && data.images.size() <= 8 && data.images[0] is string &&
      data.availabilityStatus in ['Available', 'Made to Order', 'Out of Stock'] &&
      (!('estimatedDispatchDays' in data) || (data.estimatedDispatchDays is string && data.estimatedDispatchDays.size() <= 80)) &&
      data.isBestseller is bool &&
      data.isNewArrival is bool &&
      data.popularityScore is number && data.popularityScore >= 0 && data.popularityScore <= 1000000 &&
      data.isDemo is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug', 'description', 'image', 'displayOrder', 'isActive']) &&
      data.keys().hasOnly(['name', 'slug', 'description', 'image', 'displayOrder', 'isActive']) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
      data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 100 && data.slug.matches('^[a-z0-9-]+$') &&
      data.description is string && data.description.size() <= 400 &&
      data.image is string && data.image.size() <= 500 &&
      data.displayOrder is number && data.displayOrder >= 0 && data.displayOrder <= 1000 &&
      data.isActive is bool;
    }

    function isValidDiscount(data) {
      return data.keys().hasAll(['code', 'discountType', 'value', 'minOrderAmount', 'isActive', 'createdAt']) &&
      data.keys().hasOnly(['code', 'description', 'discountType', 'value', 'minOrderAmount', 'isActive', 'createdAt']) &&
      data.code is string && data.code.size() >= 2 && data.code.size() <= 32 && data.code.matches('^[A-Z0-9_-]+$') &&
      (!('description' in data) || (data.description is string && data.description.size() <= 200)) &&
      data.discountType in ['percentage', 'flat'] &&
      data.value is number && data.value >= 1 && data.value <= 100000 &&
      data.minOrderAmount is number && data.minOrderAmount >= 0 && data.minOrderAmount <= 1000000 &&
      data.isActive is bool &&
      data.createdAt is timestamp;
    }

    function isValidStoreSetting(data) {
      return data.keys().hasAll(['freeShippingThreshold', 'standardShippingFee', 'estimatedDeliveryWindow', 'updatedAt']) &&
      data.keys().hasOnly(['freeShippingThreshold', 'standardShippingFee', 'estimatedDeliveryWindow', 'updatedAt']) &&
      data.freeShippingThreshold is number && data.freeShippingThreshold >= 0 && data.freeShippingThreshold <= 100000 &&
      data.standardShippingFee is number && data.standardShippingFee >= 0 && data.standardShippingFee <= 10000 &&
      data.estimatedDeliveryWindow is string && data.estimatedDeliveryWindow.size() >= 2 && data.estimatedDeliveryWindow.size() <= 100 &&
      data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['customerName', 'city', 'rating', 'comment', 'status', 'isDemo', 'createdAt']) &&
      data.keys().hasOnly([
        'customerName', 'city', 'sareePurchased', 'productId', 'productCode', 'productTitle',
        'rating', 'comment', 'status', 'moderatorNote', 'moderatedAt', 'isDemo', 'userId', 'createdAt'
      ]) &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 80 &&
      data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
      (!('sareePurchased' in data) || (data.sareePurchased is string && data.sareePurchased.size() <= 140)) &&
      (!('productId' in data) || (data.productId is string && data.productId.size() >= 2 && data.productId.size() <= 128 && data.productId.matches('^[a-zA-Z0-9_\\-]+$'))) &&
      (!('productCode' in data) || (data.productCode is string && data.productCode.size() <= 40)) &&
      (!('productTitle' in data) || (data.productTitle is string && data.productTitle.size() <= 140)) &&
      data.rating is number && data.rating >= 1 && data.rating <= 5 &&
      data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 600 &&
      data.status in ['pending', 'approved', 'rejected'] &&
      (!('moderatorNote' in data) || (data.moderatorNote is string && data.moderatorNote.size() <= 300)) &&
      (!('moderatedAt' in data) || data.moderatedAt is timestamp) &&
      data.isDemo is bool &&
      data.createdAt is timestamp &&
      (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    function isValidNewsletter(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
      data.keys().hasOnly(['email', 'createdAt']) &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
      data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
      data.createdAt == request.time;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['uid', 'displayName', 'email', 'phone', 'createdAt', 'updatedAt']) &&
      data.uid is string && data.uid == userId && data.uid.size() <= 128 &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
      (!('phone' in data) || (data.phone is string && data.phone.size() <= 24)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAddress(data, userId) {
      return data.keys().hasAll(['userId', 'label', 'recipientName', 'phone', 'addressLine', 'city', 'state', 'pincode', 'isDefault', 'createdAt']) &&
      data.keys().hasOnly(['userId', 'label', 'recipientName', 'phone', 'addressLine', 'city', 'state', 'pincode', 'isDefault', 'createdAt']) &&
      data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
      data.label is string && data.label.size() >= 1 && data.label.size() <= 40 &&
      data.recipientName is string && data.recipientName.size() >= 2 && data.recipientName.size() <= 120 &&
      data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 20 &&
      data.addressLine is string && data.addressLine.size() >= 5 && data.addressLine.size() <= 300 &&
      data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
      data.state is string && data.state.size() >= 2 && data.state.size() <= 80 &&
      data.pincode is string && data.pincode.size() == 6 && data.pincode.matches('^[0-9]{6}$') &&
      data.isDefault is bool &&
      data.createdAt is timestamp;
    }

    function isValidWishlistItem(data, userId, productId) {
      return data.keys().hasAll(['userId', 'productId', 'addedAt']) &&
      data.keys().hasOnly(['userId', 'productId', 'addedAt']) &&
      data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
      data.productId is string && data.productId == productId && data.productId.size() <= 128 &&
      data.addedAt == request.time;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
        'orderNumber', 'customerId', 'customerName', 'customerEmail', 'customerPhone',
        'shippingAddress', 'items', 'subtotal', 'shippingCharge', 'discountAmount',
        'totalAmount', 'paymentMethod', 'paymentStatus', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'orderNumber', 'customerId', 'customerName', 'customerEmail', 'customerPhone',
        'shippingAddress', 'items', 'subtotal', 'shippingCharge', 'discountCode',
        'discountAmount', 'totalAmount', 'paymentMethod', 'paymentStatus', 'paymentReference',
        'status', 'courierName', 'trackingNumber', 'customerNote',
        'loyaltyPointsEarned', 'loyaltyPointsRedeemed', 'loyaltyDiscountAmount', 'loyaltyVoucherCode',
        'createdAt', 'updatedAt'
      ]) &&
      data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 40 && data.orderNumber.matches('^[A-Z0-9-]+$') &&
      data.customerId is string && data.customerId.size() >= 2 && data.customerId.size() <= 128 &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120 &&
      data.customerEmail is string && data.customerEmail.size() >= 5 && data.customerEmail.size() <= 160 &&
      data.customerPhone is string && data.customerPhone.size() >= 10 && data.customerPhone.size() <= 20 &&
      data.shippingAddress is map &&
      data.shippingAddress.keys().hasAll(['addressLine', 'city', 'state', 'pincode']) &&
      data.shippingAddress.addressLine is string && data.shippingAddress.addressLine.size() >= 5 && data.shippingAddress.addressLine.size() <= 300 &&
      data.shippingAddress.city is string && data.shippingAddress.city.size() >= 2 && data.shippingAddress.city.size() <= 80 &&
      data.shippingAddress.state is string && data.shippingAddress.state.size() >= 2 && data.shippingAddress.state.size() <= 80 &&
      data.shippingAddress.pincode is string && data.shippingAddress.pincode.size() == 6 &&
      data.items is list && data.items.size() >= 1 && data.items.size() <= 25 && data.items[0] is map &&
      data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 5000000 &&
      data.shippingCharge is number && data.shippingCharge >= 0 && data.shippingCharge <= 50000 &&
      (!('discountCode' in data) || (data.discountCode is string && data.discountCode.size() <= 32)) &&
      data.discountAmount is number && data.discountAmount >= 0 && data.discountAmount <= 5000000 &&
      data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 5000000 &&
      data.paymentMethod in ['UPI', 'Card', 'NetBanking', 'COD'] &&
      data.paymentStatus in ['Pending', 'Test Mode - Authorised', 'Paid', 'Refunded'] &&
      (!('paymentReference' in data) || (data.paymentReference is string && data.paymentReference.size() <= 120)) &&
      data.status in [
        'Order Placed', 'Confirmed', 'Quality Inspection', 'Packaging in Progress',
        'Ready to Dispatch', 'Shipped', 'Delivered', 'Unavailable - Action Needed', 'Cancelled'
      ] &&
      (!('courierName' in data) || (data.courierName is string && data.courierName.size() <= 100)) &&
      (!('trackingNumber' in data) || (data.trackingNumber is string && data.trackingNumber.size() <= 100)) &&
      (!('customerNote' in data) || (data.customerNote is string && data.customerNote.size() <= 500)) &&
      (!('loyaltyPointsEarned' in data) || (data.loyaltyPointsEarned is number && data.loyaltyPointsEarned >= 0 && data.loyaltyPointsEarned <= 100000)) &&
      (!('loyaltyPointsRedeemed' in data) || (data.loyaltyPointsRedeemed is number && data.loyaltyPointsRedeemed >= 0 && data.loyaltyPointsRedeemed <= 100000)) &&
      (!('loyaltyDiscountAmount' in data) || (data.loyaltyDiscountAmount is number && data.loyaltyDiscountAmount >= 0 && data.loyaltyDiscountAmount <= 500000)) &&
      (!('loyaltyVoucherCode' in data) || (data.loyaltyVoucherCode is string && data.loyaltyVoucherCode.size() <= 32)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidLoyaltySummary(data, userId) {
      return data.keys().hasAll(['userId', 'pointsBalance', 'lifetimeEarned', 'totalRedeemed', 'updatedAt']) &&
      data.keys().hasOnly(['userId', 'pointsBalance', 'lifetimeEarned', 'totalRedeemed', 'updatedAt']) &&
      data.userId is string && data.userId == userId && data.userId.size() >= 2 && data.userId.size() <= 128 &&
      data.pointsBalance is number && data.pointsBalance >= 0 && data.pointsBalance <= 1000000 &&
      data.lifetimeEarned is number && data.lifetimeEarned >= 0 && data.lifetimeEarned <= 1000000 &&
      data.totalRedeemed is number && data.totalRedeemed >= 0 && data.totalRedeemed <= 1000000 &&
      data.updatedAt is timestamp;
    }

    function isValidLoyaltyTransaction(data, userId) {
      return data.keys().hasAll(['userId', 'type', 'points', 'rupeeValue', 'description', 'createdAt']) &&
      data.keys().hasOnly(['userId', 'type', 'points', 'rupeeValue', 'orderId', 'orderNumber', 'voucherCode', 'description', 'createdAt']) &&
      data.userId is string && data.userId == userId && data.userId.size() >= 2 && data.userId.size() <= 128 &&
      data.type in ['earn', 'redeem', 'voucher_issued'] &&
      data.points is number && data.points >= 1 && data.points <= 100000 &&
      data.rupeeValue is number && data.rupeeValue >= 0 && data.rupeeValue <= 500000 &&
      (!('orderId' in data) || (data.orderId is string && data.orderId.size() >= 2 && data.orderId.size() <= 128 && isValidId(data.orderId))) &&
      (!('orderNumber' in data) || (data.orderNumber is string && data.orderNumber.size() <= 40)) &&
      (!('voucherCode' in data) || (data.voucherCode is string && data.voucherCode.size() <= 32)) &&
      data.description is string && data.description.size() >= 2 && data.description.size() <= 240 &&
      data.createdAt is timestamp;
    }

    function isValidLoyaltyVoucher(data, userId) {
      return data.keys().hasAll(['userId', 'code', 'pointsUsed', 'discountValue', 'minOrderAmount', 'status', 'createdAt']) &&
      data.keys().hasOnly(['userId', 'code', 'pointsUsed', 'discountValue', 'minOrderAmount', 'status', 'usedOrderId', 'createdAt', 'usedAt']) &&
      data.userId is string && data.userId == userId && data.userId.size() >= 2 && data.userId.size() <= 128 &&
      data.code is string && data.code.size() >= 4 && data.code.size() <= 32 && data.code.matches('^[A-Z0-9-]+$') &&
      data.pointsUsed is number && data.pointsUsed >= 10 && data.pointsUsed <= 100000 &&
      data.discountValue is number && data.discountValue >= 1 && data.discountValue <= 500000 && data.discountValue == data.pointsUsed * 5 &&
      data.minOrderAmount is number && data.minOrderAmount >= 0 && data.minOrderAmount <= 1000000 &&
      data.status in ['active', 'used'] &&
      (!('usedOrderId' in data) || (data.usedOrderId is string && data.usedOrderId.size() >= 2 && data.usedOrderId.size() <= 128 && isValidId(data.usedOrderId))) &&
      data.createdAt is timestamp &&
      (!('usedAt' in data) || data.usedAt is timestamp);
    }

    function isValidManufacturer(data) {
      return data.keys().hasAll(['name', 'location', 'phone', 'assignedProductCodes', 'isActive', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['name', 'location', 'contactPerson', 'phone', 'assignedProductCodes', 'purchasePricesByCode', 'availabilityNotes', 'isActive', 'createdAt', 'updatedAt']) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 140 &&
      data.location is string && data.location.size() >= 2 && data.location.size() <= 140 &&
      (!('contactPerson' in data) || (data.contactPerson is string && data.contactPerson.size() <= 120)) &&
      data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 24 &&
      data.assignedProductCodes is list && data.assignedProductCodes.size() <= 100 &&
      (data.assignedProductCodes.size() == 0 || data.assignedProductCodes[0] is string) &&
      (!('purchasePricesByCode' in data) || data.purchasePricesByCode is map) &&
      (!('availabilityNotes' in data) || (data.availabilityNotes is string && data.availabilityNotes.size() <= 800)) &&
      data.isActive is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidOrderProcurement(data) {
      return data.keys().hasAll([
        'orderId', 'orderNumber', 'internalStage', 'sellingTotal',
        'manufacturerPurchaseCost', 'packagingCost', 'shippingCost',
        'paymentGatewayFee', 'otherVariableCost', 'grossMargin', 'netContribution', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'orderId', 'orderNumber', 'internalStage', 'manufacturerId',
        'manufacturerName', 'manufacturerPhone', 'productCodes', 'sellingTotal',
        'manufacturerPurchaseCost', 'packagingCost', 'shippingCost',
        'paymentGatewayFee', 'otherVariableCost', 'grossMargin', 'netContribution',
        'procurementNotes', 'alternativeOffered', 'updatedAt'
      ]) &&
      data.orderId is string && data.orderId.size() >= 2 && data.orderId.size() <= 128 &&
      data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 40 &&
      data.internalStage in [
        'Pending Availability Check', 'Availability Confirmed', 'Procurement Ordered',
        'Received from Manufacturer', 'Inspection Passed', 'Packaging',
        'Dispatched', 'Manufacturer Unavailable'
      ] &&
      (!('manufacturerId' in data) || (data.manufacturerId is string && data.manufacturerId.size() <= 128)) &&
      (!('manufacturerName' in data) || (data.manufacturerName is string && data.manufacturerName.size() <= 140)) &&
      (!('manufacturerPhone' in data) || (data.manufacturerPhone is string && data.manufacturerPhone.size() <= 30)) &&
      (!('productCodes' in data) || (data.productCodes is list && data.productCodes.size() <= 25 && (data.productCodes.size() == 0 || data.productCodes[0] is string))) &&
      data.sellingTotal is number &&
      data.manufacturerPurchaseCost is number &&
      data.packagingCost is number &&
      data.shippingCost is number &&
      data.paymentGatewayFee is number &&
      data.otherVariableCost is number &&
      data.grossMargin is number &&
      data.netContribution is number &&
      (!('procurementNotes' in data) || (data.procurementNotes is string && data.procurementNotes.size() <= 1000)) &&
      (!('alternativeOffered' in data) || (data.alternativeOffered is string && data.alternativeOffered.size() <= 400)) &&
      data.updatedAt is timestamp;
    }

    function isValidOrderTracking(data) {
      return data.keys().hasAll([
        'orderNumber', 'customerId', 'status', 'paymentMethod', 'paymentStatus',
        'itemCount', 'itemTitles', 'destinationCityState', 'totalAmount', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'orderNumber', 'customerId', 'status', 'paymentMethod', 'paymentStatus',
        'courierName', 'trackingNumber', 'itemCount', 'itemTitles',
        'destinationCityState', 'totalAmount', 'createdAt', 'updatedAt'
      ]) &&
      data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 40 && data.orderNumber.matches('^[A-Z0-9-]+$') &&
      data.customerId is string && data.customerId.size() >= 2 && data.customerId.size() <= 128 &&
      data.status in [
        'Order Placed', 'Confirmed', 'Quality Inspection', 'Packaging in Progress',
        'Ready to Dispatch', 'Shipped', 'Delivered', 'Unavailable - Action Needed', 'Cancelled'
      ] &&
      data.paymentMethod in ['UPI', 'Card', 'NetBanking', 'COD'] &&
      data.paymentStatus in ['Pending', 'Test Mode - Authorised', 'Paid', 'Refunded'] &&
      (!('courierName' in data) || (data.courierName is string && data.courierName.size() <= 100)) &&
      (!('trackingNumber' in data) || (data.trackingNumber is string && data.trackingNumber.size() <= 100)) &&
      data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 100 &&
      data.itemTitles is list && data.itemTitles.size() >= 1 && data.itemTitles.size() <= 25 && data.itemTitles[0] is string &&
      data.destinationCityState is string && data.destinationCityState.size() >= 2 && data.destinationCityState.size() <= 160 &&
      data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 5000000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidEmailNotification(data) {
      return data.keys().hasAll([
        'orderId', 'orderNumber', 'customerId', 'recipientEmail',
        'eventStatus', 'subject', 'previewText', 'deliveryState', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'orderId', 'orderNumber', 'customerId', 'recipientEmail',
        'eventStatus', 'subject', 'previewText', 'deliveryState', 'providerMessage', 'createdAt'
      ]) &&
      data.orderId is string && data.orderId.size() >= 2 && data.orderId.size() <= 128 &&
      data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 40 && data.orderNumber.matches('^[A-Z0-9-]+$') &&
      data.customerId is string && data.customerId.size() >= 2 && data.customerId.size() <= 128 &&
      data.recipientEmail is string && data.recipientEmail.size() >= 5 && data.recipientEmail.size() <= 160 &&
      data.eventStatus is string && data.eventStatus.size() >= 2 && data.eventStatus.size() <= 60 &&
      data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 200 &&
      data.previewText is string && data.previewText.size() >= 2 && data.previewText.size() <= 1200 &&
      data.deliveryState in ['sent_smtp', 'queued_cloud_function', 'failed'] &&
      (!('providerMessage' in data) || (data.providerMessage is string && data.providerMessage.size() <= 300)) &&
      data.createdAt is timestamp;
    }

    // Storefront Catalog Collections
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(productId) && isAdmin() && isValidProduct(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create, update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming());
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /discounts/{discountId} {
      allow get: if isValidId(discountId);
      allow list: if isAdmin();
      allow create: if isValidId(discountId) && isAdmin() && isValidDiscount(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(discountId) && isAdmin() && isValidDiscount(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(discountId) && isAdmin();
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update: if isValidId(settingId) && isAdmin() && isValidStoreSetting(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isValidId(settingId) && isAdmin();
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (
        existing().status == 'approved' ||
        (existing().isDemo == true && !('status' in existing())) ||
        isAdmin() ||
        (isSignedIn() && 'userId' in existing() && existing().userId == request.auth.uid)
      );
      allow list: if resource.data.status == 'approved' ||
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(reviewId) && isValidReview(incoming()) && (
        (isAdmin() && incoming().createdAt == request.time) ||
        (
          isVerifiedUser() &&
          incoming().isDemo == false &&
          incoming().userId == request.auth.uid &&
          incoming().status == 'pending' &&
          'productId' in incoming() &&
          !('moderatorNote' in incoming()) &&
          !('moderatedAt' in incoming()) &&
          incoming().createdAt == request.time
        )
      );
      allow update: if isValidId(reviewId) && isAdmin() && isValidReview(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        (!('userId' in existing()) || incoming().userId == existing().userId) &&
        (!('productId' in existing()) || incoming().productId == existing().productId);
      allow delete: if isValidId(reviewId) && isAdmin();
    }

    match /newsletter/{subscriberId} {
      allow create: if isValidId(subscriberId) && isValidNewsletter(incoming());
      allow read, update, delete: if isAdmin();
    }

    // Customer Profiles, Addresses & Wishlists
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isVerifiedUser() && (isOwner(userId) || isAdmin()) && isValidUser(incoming(), userId) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isVerifiedUser() && (isOwner(userId) || isAdmin()) && isValidUser(incoming(), userId) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt']);
      allow delete: if isValidId(userId) && isAdmin();

      match /addresses/{addressId} {
        allow get: if isValidId(userId) && isValidId(addressId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(addressId) && isVerifiedUser() && (isOwner(userId) || isAdmin()) && isValidAddress(incoming(), userId) && incoming().createdAt == request.time;
        allow update: if isValidId(userId) && isValidId(addressId) && isVerifiedUser() && (isOwner(userId) || isAdmin()) && isValidAddress(incoming(), userId) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(userId) && isValidId(addressId) && (isOwner(userId) || isAdmin());
      }

      match /wishlist/{productId} {
        allow get: if isValidId(userId) && isValidId(productId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(productId) && isVerifiedUser() && (isOwner(userId) || isAdmin()) && isValidWishlistItem(incoming(), userId, productId);
        allow delete: if isValidId(userId) && isValidId(productId) && (isOwner(userId) || isAdmin());
      }

      match /loyalty_summary/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && docId == 'account' && isVerifiedUser() && (isOwner(userId) || isAdmin()) &&
          isValidLoyaltySummary(incoming(), userId) && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && docId == 'account' && isVerifiedUser() && (isOwner(userId) || isAdmin()) &&
          isValidLoyaltySummary(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().lifetimeEarned >= existing().lifetimeEarned &&
          incoming().totalRedeemed >= existing().totalRedeemed &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['pointsBalance', 'lifetimeEarned', 'totalRedeemed', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }

      match /loyalty_transactions/{txId} {
        allow get: if isValidId(userId) && isValidId(txId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(txId) && isVerifiedUser() && (isOwner(userId) || isAdmin()) &&
          isValidLoyaltyTransaction(incoming(), userId) &&
          incoming().createdAt == request.time && (
            isAdmin() ||
            incoming().type != 'earn' ||
            ('orderId' in incoming() && existsAfter(/databases/$(database)/documents/orders/$(incoming().orderId)))
          );
        allow update, delete: if isValidId(userId) && isValidId(txId) && isAdmin();
      }

      match /loyalty_vouchers/{voucherId} {
        allow get: if isValidId(userId) && isValidId(voucherId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(voucherId) && isVerifiedUser() && (isOwner(userId) || isAdmin()) &&
          isValidLoyaltyVoucher(incoming(), userId) &&
          incoming().status == 'active' &&
          incoming().createdAt == request.time &&
          !('usedOrderId' in incoming()) &&
          !('usedAt' in incoming());
        allow update: if isValidId(userId) && isValidId(voucherId) &&
          isValidLoyaltyVoucher(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().code == existing().code &&
          incoming().pointsUsed == existing().pointsUsed &&
          incoming().discountValue == existing().discountValue &&
          incoming().createdAt == existing().createdAt && (
            isAdmin() || (
              isVerifiedUser() &&
              isOwner(userId) &&
              existing().status == 'active' &&
              incoming().status == 'used' &&
              'usedOrderId' in incoming() &&
              incoming().usedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'usedOrderId', 'usedAt']) &&
              existsAfter(/databases/$(database)/documents/orders/$(incoming().usedOrderId))
            )
          );
        allow delete: if isValidId(userId) && isValidId(voucherId) && isAdmin();
      }
    }

    // Customer-Visible Orders (Zero Manufacturer / Cost Exposure)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().customerId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(orderId) && isValidOrder(incoming()) &&
        incoming().customerId == request.auth.uid &&
        incoming().status == 'Order Placed' &&
        incoming().paymentStatus in ['Pending', 'Test Mode - Authorised'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(orderId) && isValidOrder(incoming()) &&
        incoming().customerId == existing().customerId &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isVerifiedUser() &&
            existing().customerId == request.auth.uid &&
            existing().status == 'Order Placed' &&
            incoming().status == 'Cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Zero-PII Public Order Tracking Projection (Keyed by SHA-256 of orderNumber::email)
    match /order_tracking/{trackingId} {
      allow get: if isValidId(trackingId) && trackingId.matches('^trk_[a-f0-9]{64}$');
      allow list: if false;
      allow create: if isValidId(trackingId) && trackingId.matches('^trk_[a-f0-9]{64}$') &&
        isValidOrderTracking(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isVerifiedUser() &&
            incoming().customerId == request.auth.uid &&
            incoming().status == 'Order Placed' &&
            incoming().paymentStatus in ['Pending', 'Test Mode - Authorised']
          )
        );
      allow update: if isValidId(trackingId) && trackingId.matches('^trk_[a-f0-9]{64}$') &&
        isValidOrderTracking(incoming()) &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().customerId == existing().customerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isVerifiedUser() &&
            existing().customerId == request.auth.uid &&
            existing().status == 'Order Placed' &&
            incoming().status == 'Cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(trackingId) && isAdmin();
    }

    // Order Status Email Notification Audit Logs & Previews
    match /email_notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (isAdmin() || (isSignedIn() && existing().customerId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isValidId(notificationId) &&
        isValidEmailNotification(incoming()) &&
        incoming().createdAt == request.time && (
          isAdmin() ||
          (
            isVerifiedUser() &&
            incoming().customerId == request.auth.uid &&
            incoming().eventStatus in ['Order Placed', 'Cancelled']
          )
        );
      allow update, delete: if isValidId(notificationId) && isAdmin();
    }

    // ADMIN-ONLY Internal Sourcing, Manufacturers & Profit Ledger
    match /order_procurement/{orderId} {
      allow get, delete: if isValidId(orderId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(orderId) && isAdmin() && isValidOrderProcurement(incoming()) && incoming().orderId == orderId && incoming().updatedAt == request.time;
    }

    match /manufacturers/{manufacturerId} {
      allow get, delete: if isValidId(manufacturerId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(manufacturerId) && isAdmin() && isValidManufacturer(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(manufacturerId) && isAdmin() && isValidManufacturer(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
    }

    match /admin_settings/{settingId} {
      allow get, delete: if isValidId(settingId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(settingId) && isAdmin() &&
        incoming().keys().hasAll(['defaultPackagingCost', 'defaultShippingCost', 'gatewayFeePercent', 'defaultOtherVariableCost', 'updatedAt']) &&
        incoming().keys().hasOnly(['defaultPackagingCost', 'defaultShippingCost', 'gatewayFeePercent', 'defaultOtherVariableCost', 'updatedAt']) &&
        incoming().defaultPackagingCost is number &&
        incoming().defaultShippingCost is number &&
        incoming().gatewayFeePercent is number &&
        incoming().defaultOtherVariableCost is number &&
        incoming().updatedAt == request.time;
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(userId) && isAdmin();
    }
  }
}
